from telegram import (
    Update,
    InlineKeyboardButton,
    InlineKeyboardMarkup,
)
from telegram.ext import (
    ApplicationBuilder,
    CommandHandler,
    CallbackQueryHandler,
    MessageHandler,
    ContextTypes,
    filters,
)

from config import BOT_TOKEN
from ai_client import chat

from database import (
    init_db,
    upsert_user,
    save_message,
    get_recent_messages,
)

from handlers.notes import (
    note_command,
    notes_command,
    delete_note_command,
)

from handlers.reminders import (
    reminder_command,
    reminders_command,
)


# =========================
# Main Menu
# =========================

def main_menu():
    keyboard = [
        [
            InlineKeyboardButton("🤖 Dariush AI", callback_data="chat"),
        ],
        [
            InlineKeyboardButton("📝 Notes", callback_data="notes"),
            InlineKeyboardButton("⏰ Reminders", callback_data="reminders"),
        ],
        [
            InlineKeyboardButton("📰 Post Maker", callback_data="post_maker"),
        ],
        [
            InlineKeyboardButton("🎨 Create Image", callback_data="image"),
            InlineKeyboardButton("🕹️ Pixel Art", callback_data="pixel_art"),
        ],
        [
            InlineKeyboardButton("⚙️ Settings", callback_data="settings"),
        ],
    ]

    return InlineKeyboardMarkup(keyboard)


# =========================
# /start
# =========================

async def start(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    if not update.effective_user or not update.message:
        return

    user = update.effective_user

    upsert_user(
        user.id,
        username=user.username,
        first_name=user.first_name,
    )

    await update.message.reply_text(
        "سلام 👋\n\n"
        "من داریوش هستم، دستیار شخصی و منشی هوشمند شما. 🤖\n\n"
        "از منوی زیر انتخاب کن یا مستقیماً برام پیام بفرست.",
        reply_markup=main_menu(),
    )


# =========================
# /help
# =========================

